<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.ivproduction.ncode</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <TrimMode>full</TrimMode>
    <ApplicationTitle>Ncode Game</ApplicationTitle>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ncode.Core\Ncode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Ncode\Program.cs" Link="Ncode\Program.cs" />
    <Compile Include="..\Ncode\Audio\AndroidAudioPlayer.cs" Link="Ncode\Audio\AndroidAudioPlayer.cs" />
    <Compile Include="..\Ncode\Audio\WindowsAudioPlayer.cs" Link="Ncode\Audio\WindowsAudioPlayer.cs" />
    <Compile Include="..\Ncode\Platform\AndroidClipboard.cs" Link="Ncode\Platform\AndroidClipboard.cs" />
    <Compile Include="..\Ncode\Platform\AndroidDialogService.cs" Link="Ncode\Platform\AndroidDialogService.cs" />
    <Compile Include="..\Ncode\Platform\WindowsClipboard.cs" Link="Ncode\Platform\WindowsClipboard.cs" />
    <Compile Include="..\Ncode\Platform\WindowsDialogService.cs" Link="Ncode\Platform\WindowsDialogService.cs" />
    <Compile Include="..\Ncode\Rendering\AndroidGameHost.cs" Link="Ncode\Rendering\AndroidGameHost.cs" />
    <Compile Include="..\Ncode\Rendering\WindowsFormsGameHost.cs" Link="Ncode\Rendering\WindowsFormsGameHost.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameBundleZip)' != '' and Exists('$(GameBundleZip)')">
    <AndroidAsset Include="$(GameBundleZip)">
      <LogicalName>GameBundle.zip</LogicalName>
    </AndroidAsset>
  </ItemGroup>
</Project>