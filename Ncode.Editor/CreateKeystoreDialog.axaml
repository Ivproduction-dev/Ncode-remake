<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ncode.Editor.CreateKeystoreDialog"
        Title="Создание подписи (keystore)" Width="560" Height="680"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="#141413" Foreground="#FAF9F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#1B1B19" BorderBrush="#30302E" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Border Width="36" Height="36" CornerRadius="4" Background="#B53333" Margin="0,0,12,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#FAF9F5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Создание ключа подписи" FontFamily="Georgia, serif" FontSize="15" FontWeight="SemiBold" Foreground="#FAF9F5"/>
                    <TextBlock Name="SubtitleText" Text="Для .APK — потеря = потеря подписи, для .AAB — потеря = потеря приложения" FontSize="11" Foreground="#D97757" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="22,16">
            <StackPanel Spacing="12">
                <Border Background="#2A1B1B" BorderBrush="#B53333" BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="⚠ ВНИМАНИЕ — ПОТЕРЯ = ПОТЕРЯ ПОДПИСИ" FontWeight="Bold" FontSize="12" Foreground="#B53333"/>
                        <TextBlock Name="WarningText" Text="Если потеряете файл keystore или пароль — не сможете обновить игру. Для .APK это потеря подписи (придётся выпускать новое приложение), для .AAB — потеря приложения в Play Store навсегда. Сделайте бэкап сразу!" FontSize="11" Foreground="#D97757" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="6">
                    <TextBlock Text="Куда сохранить keystore (.keystore)" FontWeight="SemiBold" FontSize="13" Foreground="#FAF9F5"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Name="KeystorePathBox" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                        <Button Name="BrowseKeystoreBtn" Grid.Column="1" Content="Выбрать..." Margin="8,0,0,0" Padding="10,5" CornerRadius="4" FontSize="12" Classes="secondary"/>
                    </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                        <TextBlock Text="Alias ключа" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="AliasBox" Text="ncode" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                        <TextBlock Text="Срок (дней)" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="ValidityBox" Text="10000" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                        <TextBlock Text="Пароль хранилища" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="StorePassBox" PasswordChar="•" RevealPassword="True" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                        <TextBlock Text="Пароль ключа" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="KeyPassBox" PasswordChar="•" RevealPassword="True" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#2A2A27" Margin="0,4"/>

                <TextBlock Text="Данные владельца (DName) — все поля обязательны" FontWeight="SemiBold" FontSize="13" Foreground="#FAF9F5"/>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                        <TextBlock Text="CN — Имя и фамилия" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="CnBox" PlaceholderText="Ivan Petrov" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                        <TextBlock Text="OU — Отдел" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="OuBox" PlaceholderText="Dev" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                        <TextBlock Text="O — Организация" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="OBox" PlaceholderText="Ivproduction" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                        <TextBlock Text="L — Город" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="LBox" PlaceholderText="Moscow" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                        <TextBlock Text="ST — Регион" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="StBox" PlaceholderText="Moscow" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                        <TextBlock Text="C — Страна (2 буквы)" FontSize="12" Foreground="#B0AEA5"/>
                        <TextBox Name="CBox" Text="RU" MaxLength="2" Padding="10,6" FontSize="13" Background="#1E1E1C" Foreground="#FAF9F5" BorderBrush="#30302E" CornerRadius="4"/>
                    </StackPanel>
                </Grid>

                <Border Name="ErrorCard" IsVisible="False" Background="#2A1B1B" BorderBrush="#B53333" BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <TextBlock Name="ErrorText" Foreground="#FAF9F5" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#1B1B19" BorderBrush="#30302E" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button Name="CancelBtn" Content="Отмена" DockPanel.Dock="Left" Padding="12,5" CornerRadius="4" FontSize="12" Classes="secondary"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="CreateBtn" Content="Создать и продолжить →" Padding="14,5" CornerRadius="4" FontSize="12" Classes="accent"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
