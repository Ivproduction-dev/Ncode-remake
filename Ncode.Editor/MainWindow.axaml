<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="Ncode.Editor.MainWindow"
        Title="Ncode" Width="1200" Height="750" Background="#1E1E2E">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10,8">
            <Button Name="NewProjectButton" Content="Новый проект" ToolTip.Tip="Создать проект"/>
            <Button Name="OpenProjectButton" Content="Открыть проект" ToolTip.Tip="Открыть папку проекта"/>
            <Button Name="OpenFolderButton" Content="Папка" ToolTip.Tip="Открыть папку"/>
            <Button Name="SaveButton" Content="Сохранить" ToolTip.Tip="Сохранить файл"/>
            <Button Name="RunButton" Classes="accent" Content="Запустить" ToolTip.Tip="Запустить"/>
            <Button Name="StopButton" Content="Стоп" IsEnabled="False" ToolTip.Tip="Остановить"/>
            <CheckBox Name="HighlightCheck" Content="Подсветка" IsChecked="True" VerticalAlignment="Center"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#89B4FA" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="StatusText" Foreground="#11111B" VerticalAlignment="Center" Text="Ncode"/>
                <TextBlock Name="FileText" Grid.Column="1" Foreground="#11111B" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Name="CaretText" Grid.Column="2" Foreground="#11111B" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Height="240" BorderThickness="0,1,0,0" BorderBrush="#3C3C3C" Padding="10,6">
            <Grid RowDefinitions="Auto,*,Auto">
                <DockPanel>
                    <Button Name="ClearButton" DockPanel.Dock="Right" Content="Очистить"/>
                    <TextBlock Text="ВЫВОД" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.7"/>
                </DockPanel>
                <TextBox Name="OutputBox" Grid.Row="1" Margin="0,6" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                         Background="#11111B" Foreground="#CDD6F4" CaretBrush="#F5C2E7" SelectionBrush="#45475A"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <TextBox Name="InputBox" PlaceholderText="Ввод для спросить..." Width="400" Background="#11111B" Foreground="#CDD6F4"/>
                    <Button Name="SendButton" Content="Отправить"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid ColumnDefinitions="280,*">
            <Border Grid.Column="0" Margin="10,0,4,0" BorderThickness="0,0,1,0" BorderBrush="#3C3C3C" Padding="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ФАЙЛЫ" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6"/>
                    <TreeView Name="FileTree" Background="Transparent" Foreground="#CDD6F4"/>
                </DockPanel>
            </Border>
            <TabControl Name="EditorTabs" Grid.Column="1" Margin="4,0,10,0"/>
        </Grid>
    </DockPanel>
</Window>
