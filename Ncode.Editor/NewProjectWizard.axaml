<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ncode.Editor.NewProjectWizard"
        Title="Новый проект" Width="440" Height="230" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10" Background="#1E1E2E">
        <StackPanel Name="Step1" Spacing="10">
            <TextBlock Text="Имя проекта" FontWeight="SemiBold" Foreground="#CDD6F4"/>
            <TextBox Name="NameBox" PlaceholderText="МояИгра" Background="#11111B" Foreground="#CDD6F4"/>
            <CheckBox Name="Is2DCheck" Content="2Д проект" Foreground="#CDD6F4"/>
            <TextBlock Name="ErrorText" Foreground="#F38BA8" IsVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Name="CancelButton" Content="Отмена"/>
                <Button Name="NextButton" Classes="accent" Content="Продолжить"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Name="Step2" Spacing="10" IsVisible="False">
            <TextBlock Text="Все ли правильно?" FontWeight="SemiBold" Foreground="#CDD6F4"/>
            <TextBlock Name="PathText" TextWrapping="Wrap" Foreground="#CDD6F4" Opacity="0.8"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Name="NoButton" Content="Нет"/>
                <Button Name="YesButton" Classes="accent" Content="Да"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
