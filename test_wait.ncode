задать t0 время
ждать 1
задать t1 время
если t1 - t0 >= 1 то
  вывести "голое ок"
конец
ждать 1 секунду
вывести "секунда ок"
ждать 2 секунды
вывести "секунды ок"
ждать 0 секунд
вывести "секунд ок"
ждать 0 минуту
вывести "минута ок"
ждать 0 минут
вывести "минут ок"
ждать 0 часов
вывести "час ок"
задать n 0
ждать n секунду
вывести "переменная ок"
задать r случайное от 1 до 10
если r >= 1 и r <= 10 то
  вывести "рандом ок"
конец
